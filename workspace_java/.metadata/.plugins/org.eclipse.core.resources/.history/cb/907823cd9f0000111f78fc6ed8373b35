package exam05;

import java.util.Scanner;

public class Ex06 {
	public static void main(String[] args) {
		// 정수 5개를 입력받아서 그 합을 출력
		
		Scanner sc = new Scanner(System.in);
		
		int[] numes = new int[5]; //작은가방 

		for (int i=0; i<5; i++) {
			System.out.print("숫자를 입력하세요 : ");
			String num_ = sc.nextLine();
			
			int num = Integer.parseInt(num_);
			
			numes[i] = num;
			
		}
		sc.close();
		
		System.out.println(numes[0]);
		System.out.println(numes[1]);
		System.out.println(numes[2]);
		System.out.println(numes[3]);
		System.out.println(numes[4]);
		
		
		
	}

}
